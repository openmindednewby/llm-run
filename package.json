{
  "name": "@dloizides/llm-run",
  "version": "0.1.0",
  "description": "Run any Hugging Face LLM in the browser with one line of code.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openmindednewby/llm-run.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "rimraf dist && tsup",
    "test": "jest",
    "test:release": "jest tests/unit tests/acceptance/ac-02-can-run.test.ts tests/acceptance/ac-11-isolation-warning.test.ts tests/acceptance/ac-07-integrity.test.ts tests/acceptance/ac-12-openai-shape.test.ts tests/acceptance/ac-09-unsupported-arch.test.ts",
    "lint": "eslint src tests e2e/page e2e/fixtures e2e/vite.config.ts playwright.config.ts --ext .ts --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "prepublishOnly": "npm run build && npm run test:release"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "wasm-feature-detect": "^1.8.0"
  },
  "peerDependencies": {
    "@wllama/wllama": "3.6.1",
    "@mlc-ai/web-llm": "^0.2.85"
  },
  "peerDependenciesMeta": {
    "@mlc-ai/web-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@wllama/wllama": "3.6.1",
    "@mlc-ai/web-llm": "^0.2.85",
    "@webgpu/types": "^0.1.60",
    "@playwright/test": "^1.55.0",
    "vite": "^7.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "jest-environment-jsdom": "^30.0.0",
    "rimraf": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-sonarjs": "^4.0.3"
  }
}
